# Copy this file to .env.local and fill in the real values from your
# Supabase project (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (Project Settings -> API -> service_role) - bypasses RLS.
# Required for add-staff/delete-staff/toggle-user AND the forgot-password
# route (both use src/lib/supabase/admin.js). Never expose this publicly.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com) - used to email the owner a password-reset link.
# RESEND_FROM_EMAIL must be an address on a domain verified in your Resend
# account (or Resend's sandbox address for testing - see their dashboard).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Forecasting microservice (FastAPI on Render, see forecast-service/).
# FORECAST_SERVICE_KEY must match the X-Internal-Key the service checks -
# same value set in the Render service's own env vars. Without both of
# these, every /forecasting request fails.
FORECAST_SERVICE_URL=https://j1spa-dss.onrender.com
FORECAST_SERVICE_KEY=

# Shared secret for /api/cron/warm-forecast. The route accepts either an
# owner session or `Authorization: Bearer $CRON_SECRET`, so this is only
# needed if you point a scheduler at that route. Nothing does today:
# pg_cron (sql/migrations/025_add_forecast_warm_cron.sql) and the GitHub workflow
# both ping the service's unauthenticated /health directly, and /forecasting
# warms it with the owner's own session. Safe to leave blank.
CRON_SECRET=
